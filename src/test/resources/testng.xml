<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-current.dtd">
<suite name="Mobile Test Automation App - HYBRID (Mobile + Web)" verbose="2" parallel="false" thread-count="1">

    <!-- Listeners para TestNG -->
    <listeners>
        <!-- TestListener: Captura SUCESSO, FALHA, SKIPPED -->
        <listener class-name="com.mobile.automation.listeners.TestListener"/>

        <!-- ReportListener: Gera relatório Allure -->
        <listener class-name="com.mobile.automation.listeners.ReportListener"/>
    </listeners>

    <!-- ========== TESTES MOBILE ========== -->
    <!-- Suite de Testes de Login Mobile -->
    <test name="Login Tests (Mobile)" enabled="false">
        <classes>
            <class name="com.mobile.test.tests.LoginTest"/>
            <class name="com.mobile.test.tests.DataDrivenLoginTest"/>
        </classes>
    </test>

    <!-- Suite de Testes de Home Mobile -->
    <test name="Home Tests (Mobile)" enabled="false">
        <classes>
            <class name="com.mobile.test.tests.HomeTest"/>
        </classes>
    </test>

    <!-- ========== TESTES WEB ========== -->
    <!-- Suite de Testes de Login Web -->
    <test name="Login Tests (Web)" enabled="true">
        <classes>
            <class name="com.mobile.test.tests.web.LoginTestWeb"/>
        </classes>
    </test>

    <!-- Suite de Testes de Home Web -->
    <test name="Home Tests (Web)" enabled="true">
        <classes>
            <class name="com.mobile.test.tests.web.HomeTestWeb"/>
        </classes>
    </test>

    <!-- Suite de Testes de Settings Web -->
    <test name="Settings Tests (Web)" enabled="false">
        <classes>
            <class name="com.mobile.test.tests.web.SettingsTestWeb"/>
        </classes>
    </test>

    <!-- ========== TESTES API ========== -->
    <!-- Suite de Testes de Usuários API -->
    <test name="User API Tests" enabled="true">
        <classes>
            <class name="com.mobile.test.tests.api.UserApiTest"/>
        </classes>
    </test>

    <!-- Suite de Testes de Validação API -->
    <test name="Validation API Tests" enabled="true">
        <classes>
            <class name="com.mobile.test.tests.api.ValidationApiTest"/>
        </classes>
    </test>

    <!--
    EXEMPLO: Para executar em paralelo, utilizar:
    <suite name="Parallel Suite" parallel="classes" thread-count="3" verbose="2">
        <test name="Test 1">
            <classes>
                <class name="com.mobile.test.tests.LoginTest"/>
            </classes>
        </test>
        <test name="Test 2">
            <classes>
                <class name="com.mobile.test.tests.HomeTest"/>
            </classes>
        </test>
    </suite>

    NOTA: Configure test.type=web ou test.type=mobile em config.properties
    -->

</suite>

